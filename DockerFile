# Test image: thin layer on top of the CI base (python, playwright, chromium, locales).
# Build base first: podman build -t ui-ci -f DockerFile.CI .
FROM quay.io/openshift-pipeline/ui-ci

# Copy the tests into /tmp/release-ui-tests
RUN mkdir /tmp/release-ui-tests
WORKDIR /tmp/release-ui-tests
COPY . .

# OpenShift arbitrary UIDs need group-write on files added by COPY above.
RUN chgrp -R 0 /tmp && \
    chmod -R g=u /tmp

CMD ["/bin/bash"]
