# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# k8s artifacts
.kube

# python-version
.python-version

# Node artifact files
node_modules/
dist/

# Agent logs files
exec/

# Environment files with secrets
.env
.env.*
!.env.example

# Markdown is documentation by default. A blanket *.md rule used to hide all of it -
# including docs/, the Claude skills, and the test plans - so scratch paths are named
# individually instead.

# Virtualenvs and caches (these carry their own markdown)
.venv/
venv/
.pytest_cache/

# Append-only run telemetry. The locator registry is shared because verified selectors
# are worth having; this is per-machine history and every contributor would conflict on
# the last line of it.
.agent/memory/outcomes.jsonl

# Generated, not written: a point-in-time snapshot that goes stale immediately
docs/qa-forge-agent-architecture.html
openshift-console-snapshot.md

# Manual test plans - kept locally, not versioned (the index goes with them, or it
# would be a contents page for files that are not in the repo)
test_plans/
MANUAL_TEST_PLAN_INDEX.md

# Work notes tied to one ticket or refactor, not reference documentation
tests/SOLID_REORGANIZATION_PROPOSAL.md
tests/SOLID_REORGANIZATION_COMPLETE.md
tests/CHANGES_SUMMARY.md
CLI_LOGIN_GUIDE.md
CODE_REVIEW_SRVKP-11541.md
CODE_REVIEW_SRVKP-11543.md
SRVKP-9273.md
SRVKP-9276.md
MONACO_EDITOR_FIX_OCP418.md
MONACO_CONTENT_REPLACEMENT_FIX.md
MONACO_EDITOR_REFACTORING.md
TEST_GENERATION_SYSTEM_READY.md
otel_markdown.md
otel_readme.md

# temp files
tmp/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# PDF files
*.pdf

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# media files
*.png

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# MCP files
.playwright-mcp/

release-ui-tests.egg-info/
build/
